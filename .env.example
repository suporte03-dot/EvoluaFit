VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- Coach IA (somente servidor: Vercel > Settings > Environment Variables) ---
# Nunca use prefixo VITE_ nestas: VITE_* vai para o bundle do navegador.
# Qualquer API compatível com OpenAI Chat Completions (OpenAI, Groq, OpenRouter, Gemini OpenAI-compat).
COACH_AI_API_KEY=
COACH_AI_MODEL=gpt-4o-mini
COACH_AI_BASE_URL=https://api.openai.com/v1
# Opcional: o /api/coach usa estas para validar o usuário; se vazias, cai em VITE_SUPABASE_URL/VITE_SUPABASE_PUBLISHABLE_KEY.
SUPABASE_URL=
SUPABASE_ANON_KEY=
